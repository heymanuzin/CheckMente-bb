# Modelo de variáveis. Copie para ".env" (que o .gitignore já ignora).
#
# ATENÇÃO: este site é estático (HTML + JS puro), então o navegador NÃO lê o .env.
# A URL e a chave PUBLISHABLE ficam em js/config.js e são públicas por natureza:
# quem protege os dados é o RLS do Supabase, não o segredo da chave.
#
# Use este arquivo só para guardar segredos que NUNCA podem ir ao front-end
# (scripts de administração, funções de servidor, etc.):

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# NUNCA coloque estas no js/config.js nem no GitHub:
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
